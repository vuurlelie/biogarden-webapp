{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=BiogardenDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "Jwt": {
    "Issuer": "BiogardenApi",
    "Audience": "BiogardenClient",
    "ExpirationMinutes": 60
  },

  "Email": {
    "Enabled": false,
    "FromName": "Bakony Kincse Biokertészet",
    "FromAddress": "info@bakonykincse.hu",
    "SmtpHost": "",
    "SmtpPort": 587,
    "Username": "",
    "Password": "",
    "UseSsl": true,
    "DisabledDeliveryPreviewDirectory": "email-previews"
  },

  "AuthEmail": {
    "ClientBaseUrl": "http://localhost:5173",
    "ConfirmEmailPath": "/email-megerosites",
    "ResetPasswordPath": "/jelszo-visszaallitas",
    "UnconfirmedAccountRetentionDays": 14
  },

  "EmailBranding": {
    "CompanyName": "Bakony Kincse Biokertészet",
    "WebsiteUrl": "https://bakonykincse.hu",
    "ContactEmail": "info@bakonykincse.hu",
    "PhoneNumber": "+36 20 800 56 06",
    "Address": "8431 Bakonyszentlászló, Jókai utca 22.",
    "LogoUrl": "http://localhost:5097/email-assets/logo.png"
  },

  "ErrorAlerts": {
    "Enabled": false,
    "RecipientEmail": "",
    "ApplicationName": "Biogarden",
    "MinimumLevel": "Error",
    "ThrottleWindowMinutes": 30
  },

  "SumUp": {
    "Enabled": false,
    "ApiKey": "",
    "MerchantCode": "",
    "Currency": "HUF",
    "ApiBaseUrl": "https://api.sumup.com",
    "RedirectUrl": "http://localhost:5173/rendeles-sikeres?sumup_checkout_reference={CHECKOUT_REFERENCE}",
    "ReturnUrl": "http://localhost:5097/api/sumup/checkout-status"
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/biogarden-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
