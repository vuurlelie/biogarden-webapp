<Project>
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
		<NuGetAudit>false</NuGetAudit>
		<!-- CI opts in explicitly; unavailable advisory data must not count as a clean audit. -->
		<NuGetAudit Condition="'$(AuditPipeline)' == 'true'">true</NuGetAudit>
		<NuGetAuditMode>all</NuGetAuditMode>
		<NuGetAuditLevel>moderate</NuGetAuditLevel>
		<WarningsAsErrors Condition="'$(AuditPipeline)' == 'true'">$(WarningsAsErrors);NU1900;NU1902;NU1903;NU1904;NU1905</WarningsAsErrors>
	</PropertyGroup>
</Project>
